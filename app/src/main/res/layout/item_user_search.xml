<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/search_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/search_avatar_left_padding"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/search_avatar_size"
            android:layout_height="@dimen/search_avatar_size"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_corner_background" />

        <View
            android:layout_width="@dimen/search_avatar_name_spacing"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/displayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/search_name_color"
                android:textSize="16sp"
                android:fontFamily="@font/lato_bold"
                android:lineSpacingExtra="12sp" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/search_name_username_spacing" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/search_username_color"
                android:textSize="16sp"
                android:fontFamily="@font/lato_regular"
                android:lineSpacingExtra="12sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_divider_height"
        android:background="@color/search_divider_color" />

</LinearLayout>